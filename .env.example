# ==========================================
# LOSTANDFOUND AI - Environment Configuration
# ==========================================

# Supabase Configuration
# Required for live PostgreSQL database, Supabase Auth, and Storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# AI Vision Embedding Service
# Options:
# 1. 'gemini': Directly calls Google Gemini Multimodal API (or proxy)
# 2. 'edge-function': Uses Supabase Edge Function `functions/v1/match-image`
# 3. 'demo': Uses deterministic local visual feature vectors with pre-seeded campus items
VITE_AI_PROVIDER=demo

# Google Gemini API Key (if VITE_AI_PROVIDER=gemini)
# Note: For production deployments, call Gemini via Supabase Edge Functions or a backend proxy
# to keep this secret secure on the server.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Similarity Matching Parameters
VITE_DEFAULT_SIMILARITY_THRESHOLD=0.65
VITE_MAX_MATCH_CANDIDATES=20

# Application URL
VITE_APP_URL=http://localhost:5173
